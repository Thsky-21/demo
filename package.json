{
  "name": "@thsky-21/thskyshield-demo",
  "version": "0.1.2",
  "description": "Zero-login demo: watch a runaway AI agent loop, overspend, and get killed at a $0.05 ceiling. Runs locally — no signup, no API key, no network. npx @thsky-21/thskyshield-demo",
  "bin": {
    "thskyshield-demo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thsky-21/demo.git"
  },
  "homepage": "https://www.thskyshield.com/demo",
  "bugs": {
    "url": "https://github.com/Thsky-21/demo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup cli.ts --format cjs --clean --target node18",
    "start": "npx tsx cli.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "agent-governance",
    "llm-budget",
    "cost-control",
    "loop-detection",
    "budget-enforcement",
    "demo"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Akash",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
